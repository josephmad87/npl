{
  "expo": {
    "name": "NPL Zimbabwe",
    "slug": "npl-mobile",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/npl-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zw.co.npl.mobile",
      "associatedDomains": ["applinks:npl.co.zw"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/npl-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "zw.co.npl.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "npl.co.zw", "pathPrefix": "/matches/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": ["android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"]
    },
    "web": {
      "favicon": "./assets/npl-icon.png"
    },
    "scheme": "npl",
    "owner": "cricketmanias-team",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      ["expo-notifications", { "defaultChannel": "match-alerts", "color": "#551725" }]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "991ec972-745d-42e1-95b8-04902b93d1ea"
      }
    }
  }
}
