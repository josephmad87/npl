VITE_API_BASE_URL=http://localhost:8000/api/v1

# Environment/release labels used by error monitoring.
VITE_APP_ENV=development
# VITE_APP_RELEASE=local

# Optional Sentry-compatible browser error monitoring. Blank disables it.
# VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional cookie-free analytics. The tracker automatically records SPA navigation.
# VITE_PLAUSIBLE_DOMAIN=npl.co.zw
# Set only when using a custom/self-hosted Plausible events endpoint.
# VITE_PLAUSIBLE_ENDPOINT=https://analytics.example.com/api/event

# Search Console HTML-tag verification token. DNS verification is preferred.
VITE_GOOGLE_SITE_VERIFICATION=
